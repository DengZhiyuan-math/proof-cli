@@ -0,0 +1,94 @@
+"""Issue #20: the Reader's commands, run through its permissions and then proof-cli itself, in the Reader's environment.
+
+Its limits on `node create` are proof-cli's, on the parsed arguments, under the reader role (proof-cli#203): a statement
+quoting `claim "` is written, and kind=claim, --parent and --reassign are refused. It writes the full bibliography
+(--identifier, --source-type), which gives its import no trust: a Trust rule covers only the researcher's imports
+(ADR-0022, proof-cli#199).
+"""
+
+import json
+import shlex
+from pathlib import Path
+
+import pytest
+from typer.testing import CliRunner
+
+from proof_agents.reader import READER_ROLE, ReaderContext
+
+domain = pytest.importorskip("proof_cli.domain")
+proof_map = pytest.importorskip("proof_cli.proof_map")
+if getattr(domain, "READER_ROLE", None) is None or not hasattr(proof_map, "would_meet_trust_rules"):
+    pytest.skip("needs proof-cli#203 (the reader role) and #199 (a Trust rule covers the researcher's imports)", allow_module_level=True)
+
+from proof_cli.cli import app  # noqa: E402
+from proof_cli.proof_map import create_node, decide_trust_rule, get_node, get_reference_review_state, list_nodes, would_meet_trust_rules  # noqa: E402
+from proof_cli.storage import ensure_project  # noqa: E402
+
+from test_reader import _allowed_denied, _permitted  # noqa: E402
+
+runner = CliRunner()
+
+
+@pytest.fixture
+def reader(tmp_path: Path):
+    store = ensure_project(tmp_path)
+    create_node(store, node_id="thm_main", kind="theorem", statement="Horocycle orbits equidistribute")
+    ctx = ReaderContext(tmp_path, name="reader-1")
+    allowed, denied = _allowed_denied(ctx.claude_args(True))
+
+    def run(command: str) -> tuple[int, dict]:
+        """The command as a Reader's turn runs it: Claude Code's permissions, then `proof` in the Reader's environment."""
+        assert _permitted(command, allowed, denied), command
+        result = runner.invoke(app, [*shlex.split(command)[1:], "--json"], env=ctx.env())
+        return result.exit_code, json.loads(result.output)
+
+    return store, run
+
+
+def test_the_reader_role_is_proof_clis(tmp_path: Path):
+    assert READER_ROLE == domain.READER_ROLE
+    assert ReaderContext(tmp_path).env()["PROOF_AGENT_ROLE"] == domain.READER_ROLE
+
+
+@pytest.mark.parametrize("statement", [
+    'By the theorem of Ratner, every orbit closure is a claim "homogeneous" in his sense',
+    "the claim 'every orbit is closed' fails for p = 2",
+])
+def test_a_statement_quoting_claim_is_written(reader, statement):
+    store, run = reader
+    code, envelope = run(f"proof node create lem_q lemma {shlex.quote(statement)} --created-by reader-1")
+    assert code == 0, envelope
+    node = get_node(store, "lem_q")
+    assert (node.kind.value, node.statement, node.created_by) == ("lemma", statement, "reader-1")
+
+
+@pytest.mark.parametrize("command, option", [
+    ('proof node create c1 claim "A step" --created-by reader-1', "kind=claim"),
+    ('proof node create c1 "claim" "By the theorem of Ratner"', "kind=claim"),
+    ('proof node create c1 claim --created-by reader-1 "By the theorem "', "kind=claim"),
+    ('proof node create c1 lemma "Height bound" --parent thm_main --created-by reader-1', "--parent"),
+    ('proof node create c1 lemma "Height bound" --created-by reader-1 --parent=thm_main', "--parent"),
+    ('proof node create c1 lemma "Height bound" --parent thm_main --reassign --created-by reader-1', "--parent"),
+    ('proof node create c1 lemma "Height bound" --reassign --created-by reader-1', "--reassign"),
+])
+def test_a_claim_a_parent_and_a_reassign_are_still_refused(reader, command, option):
+    store, run = reader
+    code, envelope = run(command)
+    assert code == 1 and (envelope["error"]["code"], envelope["error"]["option"]) == ("READER_ROLE_REFUSED", option)
+    assert [node.id for node in list_nodes(store)] == ["thm_main"] and get_node(store, "thm_main").dependencies == []
+
+
+def test_the_reader_imports_the_full_bibliography_and_its_import_still_reads_unreviewed_under_a_matching_rule(reader):
+    store, run = reader
+    decide_trust_rule(store, "doi-papers", "declare", conditions=[{"kind": "identifier_has_doi"}, {"kind": "source_type_in", "values": ["research_paper"]}],
+                      reviewer="Researcher <researcher@example.org>", rationale="published papers")
+    code, envelope = run('proof reference import ref_ratner "On Raghunathan\'s measure conjecture" 1991 --author "M. Ratner" '
+                         "--identifier 10.2307/2944357 --source-type research_paper --url https://doi.org/10.2307/2944357 --created-by reader-1")
+    assert code == 0, envelope
+    assert (envelope["data"]["identifier"], envelope["data"]["source_type"], envelope["data"]["created_by"]) == ("10.2307/2944357", "research_paper", "reader-1")
+    code, envelope = run('proof node create imp_ratner imported_result "Every ergodic invariant measure is homogeneous" '
+                         '--source-locator "Thm 1" --source-version "Ann. of Math. 1991" --reference-id ref_ratner --created-by reader-1')
+    assert code == 0, envelope
+
+    assert get_reference_review_state(store, "imp_ratner") == "unreviewed"
+    assert would_meet_trust_rules(store, "imp_ratner") == ["doi-papers"]  # shown for its own Reference review, no standing
