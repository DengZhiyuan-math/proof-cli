From 1b6af738e48beb4b84d5c4bddc8fd98308335a13 Mon Sep 17 00:00:00 2001
From: Yomathnotcool <125728853+DengZhiyuan-math@users.noreply.github.com>
Date: Sun, 11 Oct 2026 10:22:28 +0200
Subject: [PATCH 1/2] fix: a project Pursue's structure turns are the whole
 Pursue's, and stay shown once it ends (#18)

The spend line counted only the working Coordinator's own structure turns, and none once the Pursue ended: the
Reader's turn and finished Theorems' Decomposer turns were left out. It now reads the shared budget's
`structure_spent` (proof-agents#19) and, while a Theorem is worked, its Coordinator's `pursue_structure_turns`; an
older proof-agents reads as before.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/proof_web/studios.py    |  8 +++++---
 tests/test_pursue_limits.py | 23 ++++++++++++++++++++++-
 2 files changed, 27 insertions(+), 4 deletions(-)

diff --git a/src/proof_web/studios.py b/src/proof_web/studios.py
index 2fd8ee3..14f888b 100644
--- a/src/proof_web/studios.py
+++ b/src/proof_web/studios.py
@@ -803,16 +803,18 @@ class StudioHub:
 
     def _pursuit_spend(self, view: dict) -> dict:
         """The Pursue's total as it is being spent (proof-agents#19): the turns of the parts that ended and the live ones of
-        the Theorem being worked, structure turns and failed launches apart, and the time left."""
+        the Theorem being worked, structure turns (the Reader's and the Decomposers', over the whole Pursue) and failed
+        launches apart, and the time left."""
         fixed = view.get("budget")
         if not fixed:
             return {}
-        spent, structure, failed = int(fixed.get("spent") or 0), 0, int(fixed.get("failed_launches") or 0)
+        spent, structure, failed = int(fixed.get("spent") or 0), int(fixed.get("structure_spent") or 0), int(fixed.get("failed_launches") or 0)
         coordinator = self._coordinators.get(view.get("current") or "")
         if coordinator is not None and view.get("status") in _PURSUIT_AT_WORK:
             live = coordinator.view()
             spent = int(live.get("pursue_turns", spent))
-            structure = int(live.get("structure_turns") or 0)
+            # an older proof-agents counts only the working Coordinator's own structure turns
+            structure = int(live.get("pursue_structure_turns", live.get("structure_turns") or 0))
         left = max(0.0, (float(fixed["deadline"]) - time.time()) / 60) if fixed.get("deadline") else None
         return {"spend": {"turns": spent, "turns_max": fixed.get("turns_max"), "structure_turns": structure, "failed_launches": failed,
                           "minutes_max": fixed.get("minutes_max"), "minutes_left": None if left is None else round(left, 1)}}
diff --git a/tests/test_pursue_limits.py b/tests/test_pursue_limits.py
index ca3c018..f6f944e 100644
--- a/tests/test_pursue_limits.py
+++ b/tests/test_pursue_limits.py
@@ -14,7 +14,7 @@ from test_pursuit_history import _phases, _settled, _until, _view, drafted  # no
 coordinator_module = pytest.importorskip("proof_agents.coordinator")
 if not hasattr(coordinator_module, "PursueBudget"):
     pytest.skip("needs proof-agents#19", allow_module_level=True)
-from proof_agents.coordinator import pursue_limits  # noqa: E402
+from proof_agents.coordinator import PursueBudget, pursue_limits  # noqa: E402
 from proof_agents.proof_agent import budget  # noqa: E402
 
 
@@ -36,6 +36,27 @@ def test_the_researchers_total_is_what_the_pursue_fixes_and_what_it_spends_is_sh
     view = _view(client)
     assert (view["budget"]["turns_max"], view["budget"]["minutes_max"]) == (9, 30.0)
     assert view["spend"]["turns"] == 1 and view["spend"]["turns_max"] == 9 and view["spend"]["failed_launches"] == 0   # the Reader's turn
+    if hasattr(PursueBudget(1, 1), "structure_spent"):   # a proof-agents that counts structure over the whole Pursue
+        assert view["spend"]["structure_turns"] == 1   # the Reader's turn is structure, and stays counted once the Pursue ended
+
+
+def test_structure_turns_spent_are_the_whole_pursues_while_a_theorem_is_worked(drafted):  # noqa: F811
+    store, clients = drafted
+    hub = clients[0].app.studios
+
+    class Working:   # the Theorem's Coordinator at work: the Pursue's structure turns so far, and its own
+        def view(self):
+            return {"pursue_turns": 6, "pursue_structure_turns": 3, "structure_turns": 1}
+
+    hub._coordinators["T1"] = Working()
+    try:
+        budget = {"turns_max": 20, "minutes_max": 30.0, "deadline": None, "spent": 4, "structure_spent": 2, "failed_launches": 0}
+        spend = hub._pursuit_spend({"status": "pursuing", "current": "T1", "budget": budget})["spend"]
+        assert (spend["turns"], spend["structure_turns"]) == (6, 3)
+        spend = hub._pursuit_spend({"status": "done", "current": "T1", "budget": budget})["spend"]
+        assert (spend["turns"], spend["structure_turns"]) == (4, 2)   # once it ended: what the budget kept, not zero
+    finally:
+        del hub._coordinators["T1"]   # no Coordinator for the hub to close
 
 
 @pytest.mark.parametrize("limits", [{"turns": 0, "minutes": 30}, {"turns": 2.5, "minutes": 30}, {"turns": 5, "minutes": -1}, {"turns": 5}, "ten"])
