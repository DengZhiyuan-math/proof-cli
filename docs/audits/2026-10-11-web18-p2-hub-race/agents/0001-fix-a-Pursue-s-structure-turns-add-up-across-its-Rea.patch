diff --git a/tests/test_pursue_budget.py b/tests/test_pursue_budget.py
index b2758cb..cd249f3 100644
--- a/tests/test_pursue_budget.py
+++ b/tests/test_pursue_budget.py
@@ -194,6 +194,31 @@ def test_a_project_pursue_shares_one_total_with_its_reader_and_every_theorem():
     assert pursuit.view()["budget"]["spent"] == 7 and pursuit.view()["budget"]["turns_max"] == 7
 
 
+def test_a_project_pursues_structure_turns_add_up_across_the_reader_and_every_theorem_and_stay_after_it_ends():
+    worlds = {"T1": World(edges={"T1": []}, kinds={"T1": "theorem"}, budget=(3, 60.0)), "T2": World(edges={"T2": []}, kinds={"T2": "claim"}, budget=(3, 60.0))}
+    stated: list[str] = []
+    made = {name: Coordinator(CoordinatorHooks(subtree=w.subtree, run=lambda node, w=w: w.runs[node], budget=lambda w=w: w._budget,
+                                               parallel=lambda: 1), name, tick=0.01) for name, w in worlds.items()}
+    pursuit = ProjectPursuit(PursuitHooks(read=lambda provider: stated.extend(["T1", "T2"]) or {"turns": 1}, theorems=lambda: list(stated),
+                                          coordinator=made.__getitem__, budget=lambda: (3, 60.0)), tick=0.01)
+    pursuit.start("claude", limits={"turns": 20, "minutes": 60})
+    _until(lambda: worlds["T1"].runs["T1"].starts == 1, "the Decomposer on T1")
+    assert made["T1"].view()["pursue_structure_turns"] == 1   # the Reader's turn is structure
+    _split(worlds["T1"], "T1", ["A"])
+    _until(lambda: worlds["T1"].runs["A"].starts, "A worked")
+    _until(lambda: made["T1"].view()["pursue_structure_turns"] == 2, "the split's turn counted with the Reader's")
+    worlds["T1"].runs["A"].end("done", verdict="passed", turns=1, reason="review-requested"); worlds["T1"].requested.add("A")
+    _until(lambda: worlds["T1"].runs["T1"].starts == 2, "T1's own proof")
+    worlds["T1"].runs["T1"].end("done", verdict="passed", turns=1, reason="review-requested"); worlds["T1"].requested.add("T1")
+    _until(lambda: worlds["T2"].runs["T2"].starts, "T2 pursued")
+    assert (made["T2"].view()["structure_turns"], made["T2"].view()["pursue_structure_turns"]) == (0, 2)   # the Reader's and T1's split
+    assert pursuit.view()["budget"]["structure_spent"] == 2
+    worlds["T2"].runs["T2"].end("done", verdict="passed", turns=1, reason="review-requested"); worlds["T2"].requested.add("T2")
+    _until(lambda: not pursuit.active(), "the pursuit ended")
+    budget = pursuit.view()["budget"]
+    assert (budget["spent"], budget["structure_spent"]) == (5, 2)   # kept once it ended: the Reader 1, T1 1+1+1, T2 1
+
+
 def test_a_host_with_no_budget_hook_fixes_the_default_total_from_the_map_the_reader_stated():
     world = World(edges={"T1": []}, kinds={"T1": "claim"}, budget=(3, 60.0))
     stated: list[str] = []
