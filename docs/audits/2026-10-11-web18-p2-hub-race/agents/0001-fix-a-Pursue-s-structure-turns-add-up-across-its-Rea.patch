     budget = pursuit.view()["budget"]
     assert (budget["turns_max"], budget["spent"]) == (3 * 1 + 2 + 1, 1)   # T1's node budget, a split, and the Reader's one turn
+    assert budget["structure_spent"] == 1
     pursuit.stop()
 
 
