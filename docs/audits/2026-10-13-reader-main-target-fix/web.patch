+    def _check_reader_target(self, *, required: bool = False) -> dict:
+        """The Reader's declared main result must be the one Theorem project Pursue schedules.
+
+        A researcher's existing map needs no Reader report. Once a Reader has
+        left its scratch folder, a missing report is a refusal, also after restart.
+        """
+        path = self.store.root / "scratch" / "reader" / "main-target.json"
+        try:
+            target = json.loads(path.read_text(encoding="utf-8"))
+        except FileNotFoundError:
+            if not required and not path.parent.exists():
+                return {}
+            return {"error": "the Reader did not record its main target in scratch/reader/main-target.json; no node run was started",
+                    "code": "READER_TARGET_INVALID"}
+        except (OSError, UnicodeError, ValueError):
+            return {"error": "the Reader's scratch/reader/main-target.json could not be read as JSON; no node run was started",
+                    "code": "READER_TARGET_INVALID"}
+        if (not isinstance(target, dict) or not isinstance(target.get("node_id"), str) or not target["node_id"].strip()
+                or not isinstance(target.get("source"), str) or not target["source"].strip()):
+            return {"error": "the Reader's main target needs a node_id and a source location; no node run was started",
+                    "code": "READER_TARGET_INVALID"}
+        theorems = self.pursuit().hooks.theorems()
+        if theorems != [target["node_id"]]:
+            return {"error": f"the Reader's main target {target['node_id']} is not the sole Theorem scheduled by Pursue "
+                             f"({', '.join(theorems) or 'none'}); no node run was started",
+                    "code": "READER_TARGET_MISMATCH"}
+        return {"main_target": target["node_id"]}
 
