diff --git a/tests/test_coordinator.py b/tests/test_coordinator.py
index 515345e..62bd833 100644
--- a/tests/test_coordinator.py
+++ b/tests/test_coordinator.py
@@ -807,6 +807,28 @@ def test_a_child_sent_back_and_worked_again_has_its_parents_awaiting_snapshot_wo
 # -- ProjectPursuit's Stop (audit P2-6) -------------------------------------------------------------------------------------
 
 
+def test_project_pursuit_checks_the_readers_declared_main_target_before_starting_nodes():
+    """#197: the Reader identified the main result, but only a supporting theorem is selected."""
+    from types import SimpleNamespace
+
+    from proof_agents.coordinator import ProjectPursuit, PursuitHooks
+
+    stated, starts = [], []
+
+    def read(provider):
+        stated.append("thm-matrix-coeff-p")
+        return {"main_target": "lem-main"}
+
+    done = SimpleNamespace(start=lambda provider, **kwargs: starts.append("thm-matrix-coeff-p") or {},
+                           active=lambda: False, view=lambda: {"status": "done", "turns": 0})
+    pursuit = ProjectPursuit(PursuitHooks(read=read, theorems=lambda: list(stated), coordinator=lambda node: done))
+    pursuit.start("offline", limits={"turns": 60, "minutes": 120})
+    _until(lambda: not pursuit.active(), "offline pursuit ended")
+    assert pursuit.view()["status"] == "stuck"
+    assert "lem-main" in pursuit.view()["reason"] and "thm-matrix-coeff-p" in pursuit.view()["reason"]
+    assert starts == []
+
+
 def _pursuit(worlds, *, read=None, stated=None, coordinator=None, stop_read=None):
     from proof_agents.coordinator import ProjectPursuit, PursuitHooks
 
