+STRUCTURE_TURNS = 2                        # Decomposer turns per parent in a Start: one first split, one re-split (#19)
+LAUNCH_ATTEMPTS = 3                        # failed launches a node gets in a Start, the first attempt counted (#19)
+
+
+def pursue_limits(node_turns: int, node_minutes: float, open_nodes: int, parents: int, *, reader: bool = False) -> dict:
+    """The default total of a Pursue, as the page shows it before Start (#19): the node budget once per node open at
+    Start (at least one), plus the structure allowance — `STRUCTURE_TURNS` per Theorem or Lemma open at Start (at least
+    one), and the Reader's turn when one is due. The time limit is the node budget's minutes in the same proportion.
+    Fixed once the Pursue starts: the nodes a split adds later spend what is left of it."""
+    structure = STRUCTURE_TURNS * max(1, parents) + (1 if reader else 0)
+    turns = node_turns * max(1, open_nodes) + structure
+    return {"turns": turns, "minutes": round(node_minutes * turns / max(1, node_turns), 1), "node_turns": node_turns,
+            "node_minutes": node_minutes, "open_nodes": open_nodes, "structure_allowance": structure}
+
+
+class PursueBudget:
+    """One Pursue's total turns and time limit, fixed at its Start (#19) and shared by every part of it: a project
+    Pursue's Reader turn and each Theorem's Coordinator, one after another. `spent` is what the parts that have ended
+    spent; the part working adds its own live turns to it."""
+
+    def __init__(self, turns: int, minutes: float, *, now: float | None = None) -> None:
+        self.turns_max = int(turns)
+        self.minutes_max = float(minutes)
+        self.deadline = (time.time() if now is None else now) + self.minutes_max * 60
+        self.spent = 0
+        self.failed_launches = 0
+
+    @classmethod
+    def from_limits(cls, limits: dict) -> PursueBudget:
+        """The researcher's limits, as the page submits them: {"turns": a whole number ≥ 1, "minutes": > 0}."""
+        try:
+            turns, minutes = int(limits["turns"]), float(limits["minutes"])
+        except (KeyError, TypeError, ValueError) as exc:
+            raise ValueError(f"a Pursue's limits are a whole number of turns and a number of minutes: {limits!r}") from exc
+        if turns < 1 or minutes <= 0 or turns != float(limits["turns"]):
+            raise ValueError(f"a Pursue's limits are at least one turn and more than no minutes: {limits!r}")
+        return cls(turns, minutes)
+
+    def minutes_left(self) -> float:
+        return max(0.0, (self.deadline - time.time()) / 60)
+
+    def view(self) -> dict:
+        return {"turns_max": self.turns_max, "minutes_max": self.minutes_max, "deadline": self.deadline, "spent": self.spent,
+                "failed_launches": self.failed_launches}
 
 
