--- /dev/null
+++ b/tests/test_pursue_budget.py
@@ -0,0 +1,239 @@
+"""proof-agents#19 (ADR-0021 audit section 3): structure turns apart from the proof budget, under one total fixed at Start.
+
+A node's proof budget covers its Prover, Verifier, Typesetter and Numerics turns and is a ceiling; Decomposer turns are
+structure (per parent one first split and one re-split) and spend none of it. Every real turn counts toward the Pursue's
+total and every run toward its one time limit, fixed at Start for the whole Pursue — the Reader and each Theorem's
+Coordinator — and never raised. A failed launch spends no turn; three in a Start and the node is given back.
+"""
+
+import time
+
+import pytest
+
+from proof_agents.coordinator import Coordinator, CoordinatorHooks, ProjectPursuit, PursueBudget, PursuitHooks, pursue_limits
+from test_coordinator import FakeRun, World, _until
+
+
+def _split(world, parent, claims):
+    world.edges.update({parent: list(claims), **{claim: [] for claim in claims}})
+    world.runs.update({claim: FakeRun() for claim in claims})
+    world.runs[parent].end("done", turns=1, reason=f"split into {len(claims)} Claim(s): {', '.join(claims)}; the Coordinator works them")
+    world.runs[parent].claim = None
+
+
+# -- the default total, shown before Start ------------------------------------------------------------------------------
+
+
+def test_the_default_total_is_the_node_budget_per_open_node_plus_the_structure_allowance():
+    assert pursue_limits(5, 30.0, 3, 1) == {"turns": 17, "minutes": 102.0, "node_turns": 5, "node_minutes": 30.0, "open_nodes": 3,
+                                            "structure_allowance": 2}
+    assert pursue_limits(5, 30.0, 0, 0, reader=True)["turns"] == 5 + 2 + 1   # no map yet: one node budget, a split, the Reader
+    world = World(edges={"T": ["A", "B"], "A": [], "B": [], "L": []}, budget=(4, 20.0), kinds={"L": "lemma"})
+    c = world.coordinator()
+    limits = c.default_limits()
+    assert (limits["turns"], limits["open_nodes"], limits["structure_allowance"]) == (4 * 4 + 2 * 2, 4, 4)   # T and L may split
+    assert c.start("claude")["turns_max"] == limits["turns"] and c.view()["minutes_max"] == limits["minutes"]
+    c.release()
+
+
+@pytest.mark.parametrize("limits", [{"turns": 0, "minutes": 10}, {"turns": 2.5, "minutes": 10}, {"turns": 3, "minutes": 0}, {"turns": "x", "minutes": 1}, {"turns": 3}])
+def test_limits_that_are_not_a_total_are_refused_and_nothing_starts(limits):
+    world = World(edges={"T": []})
+    c = world.coordinator()
+    answer = c.start("claude", limits=limits)
+    assert answer["code"] == "INVALID_LIMITS" and world.runs["T"].starts == 0 and not c.active()
+
+
+# -- the acceptance ---------------------------------------------------------------------------------------------------------
+
+
+def test_a_parent_that_split_still_has_its_full_proof_budget():
+    world = World(edges={"T": []}, parallel=2, budget=(3, 60.0))
+    c = world.coordinator()
+    c.start("claude", limits={"turns": 20, "minutes": 60})
+    _until(lambda: world.runs["T"].starts == 1, "the Decomposer on T")
+    _split(world, "T", ["A", "B"])
+    _until(lambda: world.runs["A"].starts and world.runs["B"].starts, "the Claims worked")
+    for claim in "AB":
+        world.runs[claim].end("done", verdict="passed", turns=1, reason="review-requested"); world.requested.add(claim)
+    _until(lambda: world.runs["T"].starts == 2, "T's own proof")
+    view = c.view()
+    assert world.runs["T"].caps[1] == 3   # its whole proof budget: the Decomposer's turn was structure
+    assert (view["nodes"]["T"]["turns"], view["nodes"]["T"]["structure_turns"], view["structure_turns"]) == (0, 1, 1)
+    world.runs["T"].end("stuck", turns=2, reason="no change")
+    _until(lambda: world.runs["T"].starts == 3, "T again, with what is left of its proof budget")
+    assert world.runs["T"].caps[2] == 1
+    c.release()
+
+
+def test_a_second_re_split_on_the_same_parent_is_refused():
+    world = World(edges={"T": ["A", "B"], "A": [], "B": []}, parallel=2, budget=(2, 60.0))
+    c = world.coordinator()
+    c.start("claude", limits={"turns": 30, "minutes": 60})
+    _until(lambda: world.runs["A"].starts and world.runs["B"].starts, "A and B started")
+    world.runs["A"].end("needs-human", turns=1, reason="cannot be stated as is")
+    _until(lambda: world.runs["T"].starts == 1, "T's one re-split")
+    _split(world, "T", ["A2", "B"])
+    world.edges.pop("A")
+    world.runs["B"].end("needs-human", turns=1, reason="also stuck")   # another Claim of T parks
+    _until(lambda: c.view()["resplit_refused"], "the second re-split refused")
+    time.sleep(0.1)
+    view = c.view()
+    assert world.runs["T"].starts == 1 and view["resplit"] == ["T"] and view["resplit_refused"] == ["T"]
+    assert view["decomposed"] == ["T"] and view["nodes"]["T"]["structure_starts"] == 1
+    assert sum(note.startswith("no second re-split for T:") for note in world.notes) == 1
+    c.release()
+
+
+def test_the_total_never_rises_after_start_not_for_new_claims_retries_or_a_re_split():
+    world = World(edges={"T": []}, parallel=3, budget=(2, 60.0))
+    c = world.coordinator()
+    c.start("claude")
+    total = c.view()["turns_max"]
+    assert total == 2 * 1 + 2
+    seen = []
+    _until(lambda: world.runs["T"].starts == 1, "the Decomposer on T")
+    _split(world, "T", ["A", "B", "C"])   # three Claims: the old budget grew by three node budgets here
+    _until(lambda: world.runs["A"].starts, "the Claims worked")
+    seen.append(c.view()["turns_max"])
+    assert world.runs["A"].caps == [2] and world.runs["B"].caps == [1] and world.runs["C"].starts == 0   # 3 left: A's 2, B's 1
+    world.runs["A"].end("stuck", turns=2, reason="no change")
+    world.runs["B"].end("stuck", turns=1, reason="no change")   # 1 + 2 + 1: the total is spent: no retry, no C, no re-split
+    _until(lambda: not c.active(), "the Coordinator ended at its total")
+    seen.append(c.view()["turns_max"])
+    view = c.view()
+    assert seen == [total, total] and view["status"] == "budget" and view["turns"] == total
+    assert world.runs["C"].starts == 0 and world.runs["A"].starts == 1 and world.runs["T"].starts == 1
+    assert [entry["node"] for entry in view["parked"]] == ["A"]   # its proof budget spent
