+    # -- its history (proof-cli#201): each step a pursuit event; a new hub reads the last pursuit back ------------------
+
+    def _record(self, phase: str, **details) -> None:
+        """Record one step of the pursuit this hub started. A step after its end is not recorded. A recording that fails
+        is kept and shown with the pursuit (`record_error`), never taken for success."""
+        if record_pursuit is None:
+            return
+        with self._record_lock:
+            if self._pursuit_id is None or self._pursuit_ended:
+                return
+            try:
+                record_pursuit(self.store, phase, pursuit_id=self._pursuit_id, budget=self._budget(details.get("theorem")), **details)
+            except Exception as exc:  # noqa: BLE001 — shown with the pursuit
+                self._record_error = f"its {phase} was not recorded: {getattr(exc, 'message', exc)}"
+                return
+            self._pursuit_ended = phase == "end"
+
+    def _budget(self, theorem: str | None) -> dict | None:
+        """What a Theorem's Coordinator has spent so far, when this hub has one; nothing is made to ask."""
+        coordinator = self._coordinators.get(theorem) if theorem else None
+        if coordinator is None:
+            return None
+        view = coordinator.view()
+        return {"turns": view.get("turns"), "turns_max": view.get("turns_max")}
+
+    def _read_recorded(self, provider: str) -> dict:
+        """The Reader's turn (`_read_turn`), its end recorded."""
+        answer = self._read_turn(provider)
+        self._record("reader_end", outcome="failed" if "error" in answer else "ok", reason=str(answer.get("error") or ""))
+        return answer
+
+    def _pursued_coordinator(self, theorem: str) -> Coordinator:
+        """A Theorem's Coordinator, as the pursuit asks for it: a Theorem it moves to is recorded once."""
+        with self._record_lock:
+            moved = theorem != self._pursuit_theorem
+            self._pursuit_theorem = theorem
+        if moved:
+            self._record("theorem", theorem=theorem)
+        return self.coordinator(theorem)
+
+    def _record_ending(self) -> None:
+        """The pursuit's own notes (its `record` hook): a release that failed is recorded as that, and is no end — Stop may
+        still give the runs back; an end it reached by itself (done, stuck) is its end."""
+        pursuit = self._pursuit
+        if pursuit is None:
+            return
+        view = pursuit.view()
+        if view["status"] == "release-failed":
+            self._record("release_failed", theorem=view["current"], reason=view["reason"])
+        elif view["status"] in ("done", "stuck"):
+            self._record("end", outcome=view["status"], reason=view["reason"])
+
+    def _stop_pursuit(self, pursuit) -> dict:
+        """Stop the pursuit, its Stop recorded, and its end once its runs are given back."""
+        before = pursuit.view()
+        if before["status"] in (*_PURSUIT_AT_WORK, "release-failed"):
+            self._record("stop", theorem=before["current"], reason="stopped by the researcher")
+        answer = pursuit.stop()
+        after = pursuit.view()
+        if after["status"] == "released":
+            self._record("end", outcome="released", reason=after["reason"])
+        return answer
+
+    def _recorded_pursuit(self) -> dict | None:
+        """The project's last pursuit as its events tell it, for a hub that has not pursued: its end, or `interrupted`
+        with the last step it recorded. Nothing resumes it; a new Start rechecks claims, snapshots and node states."""
+        if project_progress is None:
+            return None
+        try:
+            pursuits = project_progress(self.store)
+        except Exception as exc:  # noqa: BLE001 — shown with the pursuit
+            self._record_error = f"its history could not be read: {exc}"
+            return None
+        if not pursuits:
+            return None
+        last = pursuits[-1]
+        reason = last["reason"]
+        if last["status"] == "interrupted":
+            step = last["events"][-1]
+            said = f": {step['reason']}" if step["reason"] else ""
+            reason = f"stopped with the server after its {last['last_phase'].replace('_', ' ')}{said}. {reason}"
+        theorems = list(dict.fromkeys(e["theorem"] for e in last["events"] if e["theorem"]))
+        return {"status": last["status"], "reason": reason, "theorems": theorems, "current": last["theorem"], "results": {},
+                "recorded": True, "pursuit_id": last["pursuit_id"], "last_phase": last["last_phase"]}
+
     def _reader_agent(self) -> AgentManager:
         """The Reader's agent manager: one for the project, rooted at it, made on first use, closed with the hub."""
         with self._lock:
