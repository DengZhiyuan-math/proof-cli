+def test_the_warnings_page_names_the_proof_toml_keys_nothing_reads():
+    """proof-cli#197: T8 set `claude_config_dir`, which no setting reads; the page says so instead of ignoring it."""
+    unknown = {"key": "claude_config_dir", "message": "proof.toml [studio] claude_config_dir is not a setting and is ignored"}
+    (shown,) = _home(state={**_state(), "settings_warnings": [unknown]}, map_={"nodes": [_node("lem_ok")]})
+    assert shown["settingsShown"] and shown["settingsWarnings"] == [unknown["message"]]
+    assert shown["railWarnings"] == "1"
+
+
+def test_the_state_carries_the_unknown_studio_keys(tmp_path):
+    from proof_agents import proof_agent
+    if not hasattr(proof_agent, "unknown_studio_keys"):
+        pytest.skip("an older proof-agents")
+    from proof_cli.storage import ensure_project
+    from proof_web.server import ReviewApp
+    store = ensure_project(tmp_path, project_id="settings")
+    (tmp_path / "proof.toml").write_text('[studio]\nparallel = 1\nclaude_config_dir = "x"\n', encoding="utf-8")
+    (item,) = ReviewApp(store).state()["settings_warnings"]
+    assert item["key"] == "claude_config_dir" and "CLAUDE_CONFIG_DIR" in item["message"]
 
 
