+++ b/tests/test_map_home.py
@@ -416,6 +416,24 @@ def test_the_warnings_page_lists_the_nodes_that_need_attention_and_the_sidebar_c
     assert quiet["attention"] == ["Nothing on the map needs attention."] and quiet["railWarnings"] == ""
 
 
+def test_the_warnings_page_says_why_a_node_may_no_longer_hold():
+    """T8 (proof-cli#197): a Definition edit read "A dependency moved to a new accepted version"; each cause now says itself."""
+    edited = {"cause": "definition-edited", "definition_id": "D", "by": "reader-1", "reason": "n = 1 is degenerate"}
+    nodes = {"nodes": [_node("C", "claim", "Names D", integrity_state="potentially-stale", stale_cause=edited),
+                       _node("L", "lemma", "Rests on C", integrity_state="potentially-stale",
+                             stale_cause={"cause": "restated", "node_id": "C", "by": "reader-1", "reason": "too strong"}),
+                       _node("M", "lemma", "Own text", integrity_state="potentially-stale", stale_cause={"cause": "restated", "node_id": "M"}),
+                       _node("N", "lemma", "Sent back", integrity_state="potentially-stale", stale_cause={"cause": "support-withdrawn", "nodes": ["C"]}),
+                       _node("P", "lemma", "Older core", integrity_state="potentially-stale")]}
+    (shown,) = _home(state=_state(), map_=nodes)
+    why = dict(zip("CLMNP", shown["attention"]))
+    assert "Definition D was edited by reader-1: n = 1 is degenerate" in why["C"] and "A dependency moved" not in why["C"]
+    assert "C, which it rests on, was restated by reader-1: too strong" in why["L"]
+    assert "Its statement was restated." in why["M"]
+    assert "It rests on C, which the researcher sent back" in why["N"]
+    assert "A dependency moved to a new accepted version" in why["P"]  # no stale_cause: the generic line, as before
+
+
 # -- each Evidence check names the Review snapshot it checked (issue #122) -------------------
 
