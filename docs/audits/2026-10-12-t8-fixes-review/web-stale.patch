index 5a862f5..69e88b4 100644
--- a/src/proof_web/static/app.js
+++ b/src/proof_web/static/app.js
@@ -1370,6 +1370,17 @@ const ATTENTION_WHY = {
   "potentially-stale": "A dependency moved to a new accepted version: it may need a re-review or a new proof.",
   unverifiable: "Its newest Review decision no longer matches its snapshot or its statement: decide it afresh.",
 };
+// why a potentially-stale node may no longer hold, from its stale_cause (proof-cli#197); the generic line without one
+function staleWhy(n) {
+  const c = n.stale_cause;
+  if (!c) return ATTENTION_WHY["potentially-stale"];
+  const who = `${c.by ? ` by ${c.by}` : ""}${c.reason ? `: ${c.reason}` : ""}`;
+  if (c.cause === "definition-edited") return `Definition ${c.definition_id} was edited${who}. Its snapshot was frozen before: it may need a new proof.`;
+  if (c.cause === "restated") return `${c.node_id === n.id ? "Its statement" : `${c.node_id}, which it rests on,`} was restated${who}. Its snapshot was frozen before: it may need a new proof.`;
+  if (c.cause === "support-withdrawn") return `It rests on ${(c.nodes || []).join(", ")}, which the researcher sent back: its snapshot awaits a decision on support that no longer holds.`;
+  if (c.cause === "upstream-challenged") return "Something it rests on is Challenged, or cites a source found no longer callable: it may no longer be safe to depend on.";
+  return ATTENTION_WHY["potentially-stale"];
+}
