+class _ReaderNotLoggedIn(_ReaderStandIn):
+    """A Reader whose turn ends at once the way Claude Code ends one for a lapsed login: is_error, subtype "success",
+    exit 1, no stderr, and the reason only in the text."""
+
+    def start(self, *args, begin=None, unless=None, **kwargs):
+        answer = super().start(*args, begin=begin, unless=unless, **kwargs)
+        with self.job.cond:
+            self.job.events += [{"t": "init", "model": "claude-opus-5-5"}, {"t": "text", "text": "Not logged in · Please run /login"},
+                                {"t": "done", "exit": 1, "is_error": True, "subtype": "success", "stderr": ""}]
+            self.job.done = True
+            self.job.cond.notify_all()
+        return answer
+
+
+def test_a_reader_turn_that_failed_names_why_not_its_subtype(drafted):
+    """T8 (proof-cli#197): a lapsed login read "the Reader's turn failed: success"; it reads as the run's turns do (#179)."""
+    store, client, reader = drafted
+    client.app.studios._reader = _ReaderNotLoggedIn()
+    assert client.app.studios._read_turn("claude") == {"error": "Not logged in · Please run /login", "code": "READER_FAILED"}
