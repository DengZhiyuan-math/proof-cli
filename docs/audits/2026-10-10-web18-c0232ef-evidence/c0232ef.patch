--- a/src/proof_web/static/app.js
+++ b/src/proof_web/static/app.js
@@ -343,12 +343,43 @@ function showPursuit(view) {
     view.status === "pursuing" ? `Pursuing ${view.current} (${(view.theorems || []).join(", ")})` : `${view.status}${view.reason ? ` — ${view.reason}` : ""}`;
   // a step of the pursuit that could not be recorded (proof-cli#201): said, not passed over
   if (view.record_error) $("pursue-status").textContent += ` · History not saved: ${view.record_error}`;
+  showPursueLimits(view, !$("pursue-start").hidden);
