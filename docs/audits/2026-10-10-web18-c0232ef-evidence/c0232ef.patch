   if (running || view.stopping) pursuitTimer = setTimeout(() => refresh().catch(showError), 5000);
 }
 
+// proof-agents#19: one total of turns and one time limit for the whole Pursue, fixed at Start. Before Start the default is
+// shown, with how it is made, for the researcher to keep or change; while it runs, what it has spent of them
+function limitsWhy(l) {
+  return `${l.node_turns} turns per node × ${Math.max(1, l.open_nodes)} open node(s) + ${l.structure_allowance} structure turn(s)`
+    + " (splits and the Reader). A node's budget is a ceiling, not a share: Claims a split adds spend what is left of the total.";
+}
+function spendText(s) {
+  return `Turns ${s.turns}/${s.turns_max}${s.structure_turns ? ` (${s.structure_turns} structure)` : ""} · failed launches ${s.failed_launches || 0}`
+    + (s.minutes_left !== null && s.minutes_left !== undefined ? ` · ${s.minutes_left} of ${s.minutes_max} min left` : "");
+}
+function showPursueLimits(view, startable) {
+  if (!$("pursue-limits")) return;
+  const limits = view.limits && !view.limits.error ? view.limits : null;
+  $("pursue-limits").hidden = !(startable && limits);
+  if (limits) {
+    for (const [id, value] of [["pursue-turns", limits.turns], ["pursue-minutes", limits.minutes]]) {
+      if (!$(id).dataset.edited) $(id).value = String(value);   // the researcher's own number is kept across refreshes
+    }
+    $("pursue-limits-why").textContent = limitsWhy(limits);
+  }
+  const spend = view.spend;
+  $("pursue-spend").hidden = !spend;
+  $("pursue-spend").textContent = spend ? spendText(spend) : "";
+}
+function pursueLimits() {
+  if (!$("pursue-limits") || $("pursue-limits").hidden) return null;
+  return { turns: Number($("pursue-turns").value), minutes: Number($("pursue-minutes").value) };
+}
+
 async function pursue(action) {
-  try { showPursuit(await api(`/api/pursue/${action}`, {})); } catch (error) {
+  const limits = action === "start" ? pursueLimits() : null;
+  try { showPursuit(await api(`/api/pursue/${action}`, limits ? { limits } : {})); } catch (error) {
     // a Stop on a pursuit that had already ended: nothing to stop, so no error; show where it stands
     if (action === "stop" && error.code === "NO_PURSUIT") { try { showPursuit(await api("/api/pursue")); } catch (again) { showError(again); } return; }
     // a Stop whose release failed (proof-agents#17): the pursuit holds its runs; say why, and show Stop again
@@ -1349,6 +1380,7 @@ document.addEventListener("DOMContentLoaded", () => {
   });
   if ($("pursue-start")) {
     $("pursue-start").addEventListener("click", () => pursue("start"));
+    for (const id of ["pursue-turns", "pursue-minutes"]) if ($(id)) $(id).addEventListener("input", () => { $(id).dataset.edited = "1"; });
     $("pursue-stop").addEventListener("click", () => pursue("stop"));
   }
   wireCanvas();
