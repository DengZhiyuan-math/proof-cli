+  // proof-agents#19: the Pursue's total turns and time limit, fixed at Start. Before Start the default and how it is made,
+  // the researcher's to keep or change (kept across refreshes once edited); while it runs, what it has spent of them
+  const limitsEdited = {};
+  function limitsBox(l) {
+    const box = h("span", null, { class: "coordinator-limits" });
+    const field = (key, label, step) => {
+      const input = h("input", null, { type: "number", min: key === "turns" ? "1" : "0.1", step, class: `coordinator-${key}`, "aria-label": label });
+      input.value = String(limitsEdited[key] ?? l[key]);
+      input.oninput = () => { limitsEdited[key] = input.value; };
+      return input;
+    };
+    box.append(h("span", "Total"), field("turns", "Total turns for this Pursue", "1"), h("span", "turns and"),
+               field("minutes", "Time limit in minutes for this Pursue", "any"), h("span", "minutes"),
+               h("span", `${l.node_turns} turns per node × ${Math.max(1, l.open_nodes)} open node(s) + ${l.structure_allowance} structure turn(s) for splits. `
+                 + "A node's budget is a ceiling, not a share: Claims a split adds spend what is left of the total.", { class: "coordinator-meta coordinator-limits-why" }));
+    return box;
+  }
+  function chosenLimits(c) {
+    if (!c.limits || c.limits.error) return null;
+    return { turns: Number(limitsEdited.turns ?? c.limits.turns), minutes: Number(limitsEdited.minutes ?? c.limits.minutes) };
+  }
+  function spentText(c) {
+    const left = c.deadline ? Math.max(0, (c.deadline * 1000 - Date.now()) / 60000) : null;
+    return `turns ${c.pursue_turns ?? c.turns}/${c.turns_max}` + (c.structure_turns ? ` (${c.structure_turns} structure)` : "")
+      + ` · failed launches ${c.failed_launches || 0}` + (left !== null ? ` · ${left.toFixed(1)} of ${c.minutes_max} min left` : "");
+  }
+
   function coordinatorCard(c) {
     const card = h("section", null, { class: "coordinator-card" });
     const line = h("div", null, { class: "coordinator-line" });
     line.append(h("span", "Subtree", { class: "coordinator-head" }));
-    const button = (label, action, cls, title) => { const b = h("button", label, { type: "button", class: cls || "", ...(title ? { title } : {}) }); b.onclick = () => coordinate(action, {}); return b; };
+    const button = (label, action, cls, title) => {
+      const b = h("button", label, { type: "button", class: cls || "", ...(title ? { title } : {}) });
+      b.onclick = () => { const limits = action === "start" ? chosenLimits(c) : null; return coordinate(action, limits ? { limits } : {}); };
+      return b;
+    };
     if (c.status === "release-failed") {  // a Stop that could not give every node back: the way out is Stop again, not a new Start
       line.append(h("span", `release failed — ${c.reason || "a node is still assigned"}`, { class: "coordinator-status release-failed" }),
                   button("Stop subtree", "release", "danger", "Try again to release the run(s) the Coordinator started"));
@@ -84,13 +115,15 @@ const IDLE_POLL_MS = 10000;  // otherwise: a Start from the map or the node page
       if (c.can_release) {
         line.append(button("Stop subtree", "release", "danger", "Release the runs this Coordinator started before starting again"));
       } else {
+        if (c.limits && !c.limits.error) line.append(limitsBox(c.limits));
         line.append(button("Pursue", "start", "primary", `Work everything under this node to the end, up to ${c.parallel || 2} runs at a time: split it first if it has no Claims; each node starts once what it rests on is Accepted or Provisional. Nothing waits for you`));
       }
+      if (c.status !== "idle" && c.turns_max) line.append(h("span", spentText(c), { class: "coordinator-meta coordinator-spent" }));
     } else {
       const sub = c.subtree || {};
       const where = c.running && c.running.length ? `running: ${c.running.join(", ")}` : "no run on now";
       line.append(h("span", c.status, { class: `coordinator-status ${c.status}` }),
-                  h("span", `${where} · ${(c.accepted || []).length} accepted of ${sub.nodes || 0} · turns ${c.turns}/${c.turns_max}`, { class: "coordinator-meta" }),
+                  h("span", `${where} · ${(c.accepted || []).length} accepted of ${sub.nodes || 0} · ${spentText(c)}`, { class: "coordinator-meta" }),
                   c.status === "paused" ? button("Resume subtree", "resume", "primary") : button("Pause subtree", "pause", "", "No new node run begins; the running ones hold after their turn"),
                   button("Stop subtree", "release", "danger", "Stop the Coordinator and release every run it started"));
     }
@@ -103,6 +136,14 @@ const IDLE_POLL_MS = 10000;  // otherwise: a Start from the map or the node page
     if ((c.held || []).length) {
       line.append(h("span", c.held.map((x) => `${x.node} waits for you — ${x.reason}`).join("; "), { class: "coordinator-meta coordinator-held", title: "The Coordinator does not restart these; open the node to see why" }));
     }
+    // proof-agents#18/#19: the nodes the total's end interrupted (a parent whose re-split it prevented, with why), and the
+    // nodes whose launches failed three times, given back: each said apart from the parked ones
+    if ((c.interrupted || []).length) {
+      line.append(h("span", c.interrupted.map((x) => `${x.node} interrupted — ${x.reason}`).join("; "), { class: "coordinator-meta coordinator-interrupted" }));
+    }
+    if ((c.launch_failed || []).length) {
+      line.append(h("span", c.launch_failed.map((x) => `${x.node} launch failed — ${x.reason}`).join("; "), { class: "coordinator-meta coordinator-launch-failed" }));
+    }
     card.append(line);
     return card;
   }
