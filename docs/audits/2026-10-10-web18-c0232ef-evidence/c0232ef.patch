+def _limits(body: dict) -> tuple[dict | None, tuple[int, dict] | None]:
+    """The researcher's total turns and minutes for a Start (proof-agents#19), checked by proof-agents' own rule before
+    anything is recorded or started: (the limits, or None for the default; a refusal, or None)."""
+    raw = body.get("limits")
+    if raw is None:
+        return None, None
+    if PursueBudget is None:
+        return None, (int(HTTPStatus.BAD_REQUEST), {"error": "this proof-agents fixes no Pursue limits", "code": "INVALID_LIMITS"})
+    try:
+        fixed = PursueBudget.from_limits(raw)
+    except ValueError as exc:
+        return None, (int(HTTPStatus.BAD_REQUEST), {"error": str(exc), "code": "INVALID_LIMITS"})
+    return {"turns": fixed.turns_max, "minutes": fixed.minutes_max}, None
+
+
 class NoStudio(Exception):
     """This node has no studio: (code, message)."""
 
