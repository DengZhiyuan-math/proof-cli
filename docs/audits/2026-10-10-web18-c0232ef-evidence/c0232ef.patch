@@ -0,0 +1,98 @@
+"""proof-web#18: a Pursue's total turns and time limit (proof-agents#19), shown before Start and submitted with it.
+
+proof-agents computes the default and enforces the limits; the hub shows the default before Start (the project's Pursue
+and a subtree's), checks and passes the researcher's own with Start, and shows what is being spent of them: real turns,
+structure turns and failed launches apart, and the time left.
+"""
+
+import pytest
+
+from _review_client import DirectClient
+from proof_cli.proof_map import create_node, split_node
+from test_pursuit_history import _phases, _settled, _until, _view, drafted  # noqa: F401 — the fixture
+
+coordinator_module = pytest.importorskip("proof_agents.coordinator")
+if not hasattr(coordinator_module, "PursueBudget"):
+    pytest.skip("needs proof-agents#19", allow_module_level=True)
+from proof_agents.coordinator import pursue_limits  # noqa: E402
+from proof_agents.proof_agent import budget  # noqa: E402
+
+
+def test_before_start_the_project_pursue_shows_its_default_total_and_how_it_is_made(drafted):  # noqa: F811
+    store, clients = drafted
+    view = _view(clients[0])
+    node_turns, node_minutes = budget(store.root)
+    assert view["can_pursue"] and view["limits"] == pursue_limits(node_turns, node_minutes, 0, 0, reader=True)
+    assert "spend" not in view   # nothing spent before Start
+
+
+def test_the_researchers_total_is_what_the_pursue_fixes_and_what_it_spends_is_shown(drafted):  # noqa: F811
+    store, clients = drafted
+    client = clients[0]
+    client.app.studios._read_turn = lambda provider: {}   # the Reader states no Theorem: the pursuit ends stuck
+    status, started = client.post("/api/pursue/start", {"provider": "stub", "limits": {"turns": 9, "minutes": 30}})
+    assert status == 200, started
+    _until(lambda: _view(client)["status"] == "stuck" and _settled(client))
+    view = _view(client)
+    assert (view["budget"]["turns_max"], view["budget"]["minutes_max"]) == (9, 30.0)
+    assert view["spend"]["turns"] == 1 and view["spend"]["turns_max"] == 9 and view["spend"]["failed_launches"] == 0   # the Reader's turn
+
+
+@pytest.mark.parametrize("limits", [{"turns": 0, "minutes": 30}, {"turns": 2.5, "minutes": 30}, {"turns": 5, "minutes": -1}, {"turns": 5}, "ten"])
+def test_limits_that_are_not_a_total_are_refused_before_anything_is_recorded_or_started(drafted, limits):  # noqa: F811
+    store, clients = drafted
+    client = clients[0]
+    read = []
+    client.app.studios._read_turn = lambda provider: read.append(provider) or {}
+    status, answer = client.post("/api/pursue/start", {"provider": "stub", "limits": limits})
+    assert status == 400 and answer["error"]["code"] == "INVALID_LIMITS"
+    assert read == [] and _view(client)["status"] == "idle"
+    from proof_cli.pursuit import project_progress
+
+    assert project_progress(store) == []   # no start recorded: nothing was started
+
+
+@pytest.fixture
+def split(tmp_path):
+    from proof_cli.storage import ensure_project
+
+    store = ensure_project(tmp_path / "project")
+    create_node(store, node_id="T", kind="theorem", statement="T holds")
+    split_node(store, "T", [{"id": "A", "statement": "A holds"}, {"id": "B", "statement": "B holds"}])
+    client = DirectClient(store)
+    yield store, client
+    client.app.close()
+
+
+def test_before_start_a_subtrees_pursue_shows_its_default_total_and_start_sends_the_researchers(split, monkeypatch):
+    store, client = split
+    idle = client.get("/api/node/T/coordinator")[1]["data"]
+    node_turns, node_minutes = budget(store.root)
+    assert idle["limits"] == pursue_limits(node_turns, node_minutes, 3, 1)
+    coordinator = client.app.studios.coordinator("T")
+    asked = {}
+    monkeypatch.setattr(coordinator, "start", lambda provider, **kw: asked.update(kw) or {"status": "running"})
+    assert client.post("/api/node/T/coordinator/start", {"provider": "claude", "limits": {"turns": 12, "minutes": 45}})[0] == 200
+    assert asked == {"limits": {"turns": 12, "minutes": 45.0}}
+    asked.clear()
+    assert client.post("/api/node/T/coordinator/start", {"provider": "claude"})[0] == 200
+    assert asked == {}   # no limits sent: proof-agents' default
+    status, answer = client.post("/api/node/T/coordinator/start", {"provider": "claude", "limits": {"turns": -3, "minutes": 45}})
+    assert status == 400 and answer["error"]["code"] == "INVALID_LIMITS"
+
+
+def test_a_subtree_started_with_the_researchers_total_enforces_it(split):
+    store, client = split
+    coordinator = client.app.studios.coordinator("T")
+
+    def no_run(node_id):   # no agent is launched by this test: each run is refused, and the Coordinator says so
+        raise RuntimeError("no run in this test")
+
+    coordinator.hooks.run = no_run
+    try:
+        answer = coordinator.start("claude", limits={"turns": 7, "minutes": 5})
+        assert "error" not in answer, answer
+        view = client.get("/api/node/T/coordinator")[1]["data"]
+        assert (view["turns_max"], view["minutes_max"]) == (7, 5.0) and "limits" not in view   # no default once it runs
+    finally:
+        coordinator.release()
