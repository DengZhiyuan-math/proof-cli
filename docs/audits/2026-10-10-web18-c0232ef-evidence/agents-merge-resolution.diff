+    def _release(self, theorem: str, coordinator: Coordinator) -> dict:
+        """Release the Theorem's Coordinator. One that fails leaves the pursuit `release-failed`, the Theorem its current
+        one, for Stop to try again; nothing is started meanwhile. A release already under way (COORDINATOR_ACTIVE) is
+        waited for, then asked again: nothing left to release (NO_COORDINATOR) once it gave the runs back, or this one's
+        own try once it failed. Only NO_COORDINATOR is no failure."""
+        answer = coordinator.release()
