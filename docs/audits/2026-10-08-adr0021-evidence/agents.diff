+def test_every_command_it_is_briefed_to_run_is_one_its_permissions_allow(tmp_path: Path):
+    """The brief's command forms, filled in as a turn would, each match an allowed Bash rule (Claude Code's `*` matches
+    anything, spaces included)."""
+    import fnmatch
+
+    allowed, denied = _allowed_denied(ReaderContext(tmp_path, name="reader-1").claude_args(True))
+    rules = [rule[5:-1] for rule in allowed if rule.startswith("Bash(")]
+    for command in (
+        'proof definition add def_height "The height $h(x)$ …" --term "Height" --created-by reader-1',
+        'proof node create thm_main theorem "Horocycle orbits equidistribute" --definition def_height --dependency lem_height --created-by reader-1',
+        'proof node create lem_height lemma "The height is proper" --created-by reader-1',
+        'proof reference import ref_ratner "On Raghunathan\'s measure conjecture" 1991 --author "M. Ratner" --url https://doi.org/10.2307/2944357 --created-by reader-1',
+        'proof node create imp_ratner imported_result "Every ergodic measure is homogeneous" --source-locator "Thm 1" --source-version "Ann. 1991" --reference-id ref_ratner --created-by reader-1',
+        'proof fog add "Uniformity in p of the rate" --near thm_main --created-by reader-1',
+    ):
+        assert any(fnmatch.fnmatchcase(command, rule) for rule in rules), command
+    claim = 'proof node create clm_1 claim "Something" --created-by reader-1'
+    assert not any(fnmatch.fnmatchcase(claim, rule) for rule in rules)
+
+
+def _permitted(command, allowed, denied):
+    """As Claude Code decides a Bash call: a deny rule that matches wins; else an allow rule must match."""
+    import fnmatch
+
+    def matches(rules):
+        return any(fnmatch.fnmatchcase(command, rule[5:-1]) for rule in rules if rule.startswith("Bash("))
+
+    return matches(allowed) and not matches(denied)
+
+
+def test_every_agent_runs_with_its_own_name_as_proof_agent_name_whatever_the_environment_says(monkeypatch, tmp_path: Path):
