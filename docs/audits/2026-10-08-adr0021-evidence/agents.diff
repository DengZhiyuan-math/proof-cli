+# ADR-0021 point 3: a Provisional dependency's statement may be used as an Accepted one's is; its proof never
+PROVISIONAL_LOCAL = ("Provisional: the Verifier passed its proof, the researcher has not accepted it — its statement may be used, "
+                     "its proof never; what you prove on it stands only if it does")
+PROVISIONAL_IMPORTED = ("Provisional: an imported result not yet Reference-reviewed — its statement may be used; read the cited "
+                        "source for what it gives, or the appeal is \"unchecked against the source\"")
+UNACCEPTED = "not yet accepted — its statement may be used only as a dependency, its proof as nothing"
+
+
+def _standing(dep: dict) -> str:
+    if dep.get("accepted"):
+        return "Accepted"
+    if dep.get("provisional"):
+        return PROVISIONAL_IMPORTED if dep.get("kind") == "imported_result" else PROVISIONAL_LOCAL
+    return UNACCEPTED
+
+
+def questions_from(log: list[dict]) -> list[dict]:
+    """The node's Standing questions off its work log (ADR-0021 point 8), oldest first: each `question` event, `open` until
+    an `answer` event names it, with the answer's redirect when the researcher chose the other reading."""
+    answers = {e.get("question_id"): e for e in log if e.get("kind") == "answer"}
+    out = []
+    for e in log:
+        if e.get("kind") != "question":
+            continue
+        answer = answers.get(e.get("id"))
+        out.append({"id": e.get("id"), "question": e.get("question") or e.get("note"), "role": e.get("role"),
+                    "state": "open" if answer is None else "answered", "redirect": (answer or {}).get("redirect")})
+    return out
+
+
+def _questions_section(parts: BriefingParts) -> str | None:
+    """The researcher's redirects first — they replace a choice a role made — then the choices still open, which stand."""
+    redirected = [q for q in parts.questions if q.get("state") == "answered" and q.get("redirect")]
+    still_open = [q for q in parts.questions if q.get("state") == "open"]
+    lines = []
+    if redirected:
+        lines.append("The researcher answered choices made on this node with another reading; follow it, and redo what rested on the choice:")
+        lines += [f"- {q.get('id')}: instead of “{q.get('question')}”, {q.get('redirect')}" for q in redirected]
+    if still_open:
+        lines.append("Choices made on this node and not yet answered (they stand until the researcher answers; do not ask them again):")
+        lines += [f"- {q.get('id')}" + (f" ({q['role']})" if q.get("role") else "") + f": {q.get('question')}" for q in still_open]
+    return "\n".join(lines) if lines else None
+
+
 def _redirect_section(parts: BriefingParts) -> str | None:
     return f"The researcher says: {parts.redirect}" if parts.redirect else None
 
