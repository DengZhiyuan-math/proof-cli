+"""The Reader (ADR-0021 point 5): briefed to state the draft as a map, permitted to write Definitions, Theorems,
+Lemmas, imported results, citations and fog under its own name, files only under scratch/reader/, and never a proof."""
+
+from pathlib import Path
+
+from proof_agents.reader import READER_READS, READER_WRITES, ReaderContext
+from proof_agents.proof_agent import NO_OTHER_PROJECT, ProofAgentContext
+
+
+def _allowed_denied(args):
+    return args[args.index("--allowedTools") + 1:args.index("--disallowedTools")], args[args.index("--disallowedTools") + 1:]
+
+
+def test_the_reader_writes_the_map_through_proof_and_files_only_under_scratch_reader(tmp_path: Path):
+    ctx = ReaderContext(tmp_path, [Path("/lib")], name="reader-1")
+    for edit, scope in ((False, None), (True, ["Edit(./x.tex)"])):
+        allowed, denied = _allowed_denied(ctx.claude_args(edit, scope))
+        assert set(READER_READS) <= set(allowed) and set(READER_WRITES) <= set(allowed)
+        for write in ("proof definition add", "proof node create * theorem", "proof node create * lemma",
+                      "proof node create * imported_result", "proof reference import", "proof fog add"):
+            assert any(write in rule for rule in allowed), write
+        files = [rule for rule in allowed if rule.startswith(("Edit", "Write", "MultiEdit"))]
+        scratch = (tmp_path / "scratch" / "reader").resolve().as_posix()
+        assert len(files) == 3 and all(rule.endswith(f"/{scratch}/**)") for rule in files), files
+        assert "Edit(./x.tex)" not in allowed  # its write scope is its own, whatever the turn's scope says
+        assert all(rule in denied for rule in NO_OTHER_PROJECT) and "Bash(python3 -c *)" in denied
+        assert any("--reassign" in rule for rule in denied)
+
+
+def test_the_reader_never_proves_splits_claims_or_decides(tmp_path: Path):
+    allowed, _ = _allowed_denied(ReaderContext(tmp_path).claude_args(True))
+    for forbidden in ("proof node split", "proof node depend", "proof node request-review", "proof node claim", "proof node unassign",
+                      "proof node progress", "proof review", "proof challenge open", "* claim *", "Bash(proof *)", "Bash(proof node create *)"):
+        assert not any(forbidden in rule for rule in allowed), forbidden
+
+
+def test_the_brief_names_its_commands_its_departures_and_what_it_never_does(tmp_path: Path):
+    brief = ReaderContext(tmp_path, [Path("/lib")], name="reader-1").brief()
+    for said in ("**Reader**", "you never\nprove", "--created-by reader-1", "proof definition add <def-id>", "--term",
+                 "proof node create <id> theorem|lemma", "--definition <def-id> --dependency <id>",
+                 "proof reference import <ref-id> \"<title>\" <year>", "imported_result", "--reference-id <ref-id>",
+                 "--source-locator", "--source-version", "proof fog add", "scratch/reader/departures.md", "closing note",
+                 "never create a Claim", "the library: /lib", "state every draft in its library"):
+        assert said in brief, said
+    assert "{" not in brief.replace("$…$", "")  # every placeholder filled
+
+
+def test_started_on_one_library_file_it_reads_that_draft_and_may_reach_its_folder(tmp_path: Path):
+    draft = Path("/elsewhere/library-horo/main.tex")
+    ctx = ReaderContext(tmp_path, [Path("/lib")], draft=draft)
+    assert "one library file, /elsewhere/library-horo/main.tex" in ctx.brief()
+    args = ctx.claude_args(False)
