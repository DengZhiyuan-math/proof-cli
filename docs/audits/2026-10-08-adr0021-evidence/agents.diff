+"""The Reader (ADR-0021 point 5): the researcher's draft in the library, stated as a proof map.
+
+A node's agent works one node (proof_agent.py); the map's agent discusses the whole map and changes nothing but the fog
+(map_agent.py). The Reader has no node either: it is started on a project, or on one library file, with nothing on the
+map or with the researcher's partial map. It reads the draft and the works it cites, then writes what the draft states:
+Definitions, the Theorems and Lemmas (or what the draft means to state where it leaves a statement empty), an imported
+result with its reference for each piece of literature the draft calls on, and fog for what the draft leaves open. It
+runs in the project root with `PROOF_ROOT` set, and every write is a `proof` command under its own name
+(`--created-by`). It never proves, never creates a Claim, never splits, claims, requests review or decides anything.
+Every place it departs from the draft — a definition corrected, a setting fixed — it records, with the reason, in
+`scratch/reader/` and in its closing note: the researcher reads those first (the Review queue, ADR-0021 point 10).
+Its turns are the same CLI turns as every agent's here, briefed and permitted by this context.
+"""
+
+from __future__ import annotations
+
+import json
+import os
+import shutil
+import sys
+from dataclasses import dataclass, field
+from pathlib import Path
+
+from .map_agent import MAP_PROOF_READS
+from .proof_agent import COMPUTATION, NO_OTHER_PROJECT, anchored, claude_md_excludes, inline_code_rules
+
+READER_NAME = "reader"   # the name its definitions, nodes and fog carry, unless `[studio] agent_name` says otherwise
+READER_SCRATCH = "scratch/reader"   # under the project root: its reading notes and the departures from the draft
+DEPARTURES_FILE = "departures.md"
+
+# what it reads besides the map agent's reads: the Definitions a statement is written in (ADR-0020)
+READER_READS = (*MAP_PROOF_READS, "Bash(proof definition list *)", "Bash(proof definition show *)")
+# what it writes, each a `proof` command: a Definition, a Theorem, a Lemma or an imported result (never a Claim: a
+# Claim is a Split's, the Decomposer's), a citation, fog, and corrections of its own unfixed text (ADR-0021 point 6:
+# proof-cli refuses any other). ADR-0010: a contract for a cooperative agent, not a sandbox. Claude Code's `*` matches
+# spaces too, so `create * theorem *` would match a Claim whose statement names a theorem (audit P2-2): the kind is
+# matched as the word right before the double-quoted statement, and the denials below catch a Claim written any other
+# way — at the cost of refusing a statement with `claim "` in it, which the Reader rewords.
+READER_KINDS = ("theorem", "lemma", "imported_result")
+READER_WRITES = (
+    "Bash(proof definition add *)",
+    *(f'Bash(proof node create * {kind} "*)' for kind in READER_KINDS),
+    "Bash(proof reference import *)",
+    "Bash(proof fog add *)",
+    "Bash(proof node restate *)",
+    "Bash(proof definition edit *)",
+)
+READER_DENIED = (
+    "Bash(proof node create * --reassign*)",   # taking a claim over with a new node
+    "Bash(proof node create * --parent*)",     # a node under a parent: an edge made at creation, a split by another name
+    # a Claim, however it is spelt: the kind before a quoted statement or an option, or quoted itself
+    'Bash(proof node create * claim "*)', "Bash(proof node create * claim '*)", "Bash(proof node create * claim -*)",
+    'Bash(proof node create * "claim" *)', "Bash(proof node create * 'claim' *)",
+    # the typed metadata a Trust rule reads (`identifier has DOI|arXiv`, `source_type in {…}`, ADR-0014): with it, a
+    # researcher's rule would make the Reader's paraphrase of a result callable with no Reference review of it (audit P2-7)
+    "Bash(proof reference import * --identifier*)", "Bash(proof reference import * --source-type*)",
+)
+
+READER_BRIEF = """\
+You are the **Reader** of a proof project (ADR-0021): you turn the researcher's draft into a proof map — a map of
+nodes (theorems, lemmas, claims and imported results), their dependencies and their proofs. You read; you never
+prove. {target}
+
+Work this way:
+1. Read before you write. What the map already holds: `proof node list`, `proof node show <id> --json`,
+   `proof definition list`, `proof reference list`, `proof fog list`. Leave what is there as it is and add only
+   what is missing: the researcher may have started the map. Then read the draft through, and the works it cites
+   (the library{library}, the web), far enough to state what the draft uses from each.
+2. Write the Definitions the statements are written in — a model's setting, a definition, notation — each once:
+   `proof definition add <def-id> "<text, Markdown with $…$>" --term "<the name>" --created-by {name}`.
+3. Write the Theorems and Lemmas the draft states, with their dependencies as the draft's proofs use them, and the
+   Definitions they are written in:
+   `proof node create <id> theorem|lemma "<statement>" --definition <def-id> --dependency <id> --created-by {name}`
+   (`--assumption "<text>"` for a standing assumption). Create a node before the nodes that rest on it. Where the
+   draft leaves a statement empty, write the statement it means — what its proof sketch or its use proves — and
+   record that as a departure (point 7).
+4. For each piece of literature the draft calls on, the citation, then the result itself as an imported result:
+   `proof reference import <ref-id> "<title>" <year> --author "<name>" --url <the DOI or arXiv link> --created-by {name}`
+   (`--author` repeatable). Leave out `--identifier` and `--source-type`: a Trust rule the researcher declares reads
+   them, and would make your statement of the result callable before anyone reviewed it; they are the researcher's to
+   give. Then
+   `proof node create <id> imported_result "<the statement used, as the work states it>" --source-locator "<theorem
+   number, page>" --source-version "<edition, arXiv version>" --reference-id <ref-id> --created-by {name}`.
+   State what the work proves, read from the work itself where you can reach it; where you cannot, say so in the
+   departures.
+5. What the draft leaves open and you cannot yet state precisely goes in the fog, near the node it is about:
+   `proof fog add "<text>" --near <id> --created-by {name}`.
+6. A later turn of yours may correct what you wrote while it is unfixed (no Review decision relied on it yet), with
+   why: `proof node restate <id> --statement "<the statement as it now reads>" --reason "<why>" --by {name}`,
+   `proof definition edit <def-id> --text "<the text as it now reads>" --reason "<why>" --by {name}`. `proof` refuses
+   the researcher's text and fixed text: that is a new Definition or a new node.
+7. Every departure from the draft — a definition corrected (one that is wrong as written: an infinite supremum, a
+   wrong group), a setting fixed, a statement written where the draft has none, a reading chosen where the text
+   admits two — goes in {scratch}/{departures} with where in the draft and why, and in your closing note. Where the
+   draft admits two readings, take the one it most likely means and record the other: nothing here waits for the
+   researcher, who reads your departures first.
+You never create a Claim (a Claim is a Split's), never split, claim, unassign or request review, never add an edge
+after creation, never write a proof, and never make a Review decision (accept, reject, …): those are the
+researcher's. You write no file but under {scratch}/. You run `proof` only as the commands above, always on this
+project ($PROOF_ROOT); computation (Python, SageMath, …) to check what a definition says is fine, with its files
+under {scratch}/.
+End with a closing note: the nodes, Definitions, imported results and fog you added, by id, and every departure.
+"""
+
+
+@dataclass
+class ReaderContext:
+    """The Reader of one project: where it runs, what it reads, how it is briefed and permitted."""
+
+    project_root: Path
+    library: list[Path] = field(default_factory=list)
+    name: str = READER_NAME
+    # the one library file it was started on, or None for the whole library (ADR-0021 point 5)
+    draft: Path | None = None
+    project_id: str | None = None   # the project's instance id, from the host (as ProofAgentContext carries it)
+    writes_files = True   # under scratch/reader/ only (latex-agent's manager reads this)
+
+    @property
+    def compiles(self) -> bool:
+        return False   # it has no node, so no studio build
+
+    @property
+    def scratch(self) -> Path:
+        return self.project_root / READER_SCRATCH
+
+    def turn_ended(self, root: Path, changed: list[str]) -> None:
+        """Nothing to record: what it changed on the map, `proof` recorded under its name already."""
+
+    def env(self) -> dict[str, str]:
+        env = {**os.environ, "PROOF_ROOT": str(self.project_root), "PROOF_AGENT_NAME": self.name}
+        env.pop("PROOF_AGENT_ROLE", None)   # no node role: `proof node progress` is not its record
+        env["CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR"] = "1"
+        if shutil.which("proof", path=env.get("PATH")) is None:  # the interpreter running proof-cli has it
+            env["PATH"] = os.pathsep.join(filter(None, [env.get("PATH"), str(Path(sys.executable).parent)]))
+        return env
+
+    def brief(self) -> str:
+        library = ", ".join(str(folder) for folder in self.library)
+        target = (f"You were started on one library file, {self.draft}: read it, and what it cites; state that draft as the map."
+                  if self.draft is not None else "You were started on the project: state every draft in its library as the map.")
+        return READER_BRIEF.format(name=self.name, target=target, library=f": {library}" if library else "",
+                                   scratch=READER_SCRATCH, departures=DEPARTURES_FILE)
+
+    def claude_args(self, edit: bool, scope_rules: list[str] | None = None, tools: list[str] | tuple[str, ...] = ()) -> list[str]:
+        """Claude Code's permissions: read the project, the library and the web; `proof` as the reads and the Reader's
+        writes; computation by name; files only under scratch/reader/, whatever `edit` and `scope_rules` say; no
+        other project."""
+        args = ["--setting-sources", "user", "--permission-prompts", "none",
+                "--settings", json.dumps({"claudeMdExcludes": claude_md_excludes(self.project_root)}),
+                "--add-dir", str(self.project_root), *(str(folder) for folder in self.library)]
+        if self.draft is not None and not any(self.draft.is_relative_to(folder) for folder in self.library):
+            args += ["--add-dir", str(self.draft.parent)]
+        scratch = self.scratch.resolve()
+        writes = [anchored(f"{tool}(./**)", scratch) for tool in ("Edit", "Write", "MultiEdit")]
+        allowed = ["Read", "Glob", "Grep", "WebSearch", "WebFetch", *READER_READS, *READER_WRITES,
+                   *(f"Bash({command} *)" for command in COMPUTATION), *writes, *tools]
+        denied = [*READER_DENIED, *inline_code_rules(COMPUTATION), *NO_OTHER_PROJECT]
+        return [*args, "--allowedTools", *allowed, "--disallowedTools", *denied]
+
+    def codex_args(self, sandbox: str) -> tuple[list[str], list[str]]:
+        """Codex's (before `exec`, after it): live web search, no project AGENTS.md, the project writable because
+        `proof` writes its database and new nodes' folders; the brief is the contract there (ADR-0010)."""
+        exec_args = ["--sandbox", sandbox, "-c", "project_doc_max_bytes=0"]
+        if sandbox == "workspace-write":
+            exec_args += ["--add-dir", str(self.project_root), "-c", "sandbox_workspace_write.network_access=true"]
+        return ["--search"], exec_args
+
+
+__all__ = ["DEPARTURES_FILE", "READER_NAME", "READER_READS", "READER_SCRATCH", "READER_WRITES", "ReaderContext"]
