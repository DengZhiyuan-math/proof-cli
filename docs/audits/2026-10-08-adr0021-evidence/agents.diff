+"""ADR-0021 points 3 and 8 in the briefs and the briefing: a judgement call is made and recorded as a Standing question,
+not asked; a Provisional dependency's statement may be used, its proof never."""
+
+from pathlib import Path
+
+from proof_agents.agent_run import AgentRun
+from proof_agents.briefing import PROVISIONAL_IMPORTED, PROVISIONAL_LOCAL, BriefingParts, build_briefing, questions_from
+from proof_agents.proof_agent import COMMANDS, ROLES, ProofAgentContext
+
+from test_prove_verify_loop import _hooks, _ScriptedAgent, _until
+
+QUESTION = "proof node progress N --question"
+
+
+def _brief(role):
+    return ProofAgentContext("N", Path("."), role=role, name="claude-code").brief()
+
+
+def _allowed(role):
+    args = ProofAgentContext("N", Path("."), role=role, name="claude-code").claude_args(True)
+    return args[args.index("--allowedTools") + 1:args.index("--disallowedTools")]
+
+
+def test_every_role_records_a_judgement_call_and_goes_on_instead_of_asking():
+    for role in ROLES:
+        brief = _brief(role)
+        assert QUESTION in brief and "A judgement call is not a reason to stop" in brief, role
+        assert any("--question" in command for command in COMMANDS[role]), role
+        assert "Bash(proof node progress N *)" in _allowed(role), role  # the command the brief gives is one the role may run
+    for role in ("prover", "verifier", "typesetter", "numerics"):
+        brief = _brief(role)
+        # needs-human is kept for what no reading settles, and it stops the node, not the subtree
+        assert "a contradiction in this node's own statement" in brief and "It stops this node, not the rest of the map" in brief, role
+        assert "a choice of definition, of norm" not in brief, role
+
+
+def test_the_verifier_may_appeal_to_a_provisional_statement_and_marks_an_unread_source():
+    brief = _brief("verifier")
+    assert "marks Provisional may be\nappealed to by its statement" in brief and "its proof never" in brief
+    assert '"unchecked against the source"' in brief
+    assert "may be used by its statement" in _brief("prover")
+
+
+def _parts(dependencies, questions=()):
+    return BriefingParts(role="prover", node_id="N", statement="S", dependencies=dependencies, questions=list(questions))
+
+
+def test_a_provisional_dependency_is_briefed_by_its_statement_and_never_its_proof():
+    text = build_briefing(_parts([
+        {"id": "A", "statement": "A holds", "accepted": True, "key_ideas": "by compactness"},
+        {"id": "C", "statement": "C holds", "accepted": False, "provisional": True, "key_ideas": "never shown"},
+        {"id": "R", "statement": "R holds", "accepted": False, "provisional": True, "kind": "imported_result"},
+        {"id": "U", "statement": "U holds", "accepted": False, "key_ideas": None},
+    ]))
+    assert "- A: A holds (Accepted)\n  key ideas: by compactness" in text
+    assert f"- C: C holds ({PROVISIONAL_LOCAL})" in text and "never shown" not in text
+    assert f"- R: R holds ({PROVISIONAL_IMPORTED})" in text
+    assert "- U: U holds (not yet accepted" in text
+
+
+def test_standing_questions_are_read_off_the_work_log_and_the_researchers_redirects_come_first():
+    log = [
+        {"kind": "question", "id": "q_1", "role": "prover", "question": "read |x| as the sup norm; or the l2 norm"},
+        {"kind": "question", "id": "q_2", "role": "verifier", "question": "Gamma is SL2(Z[1/p]); or a finite-index subgroup"},
+        {"kind": "question", "id": "q_3", "role": "prover", "question": "drop the case p = 2; or treat it"},
+        {"kind": "answer", "question_id": "q_1", "keep": False, "redirect": "use the l2 norm"},
+        {"kind": "answer", "question_id": "q_3", "keep": True, "redirect": None},
+        {"kind": "attempt", "goal": "g", "failed_on": "f"},
+    ]
+    found = questions_from(log)
+    assert [(q["id"], q["state"], q["redirect"]) for q in found] == [("q_1", "answered", "use the l2 norm"), ("q_2", "open", None), ("q_3", "answered", None)]
+    text = build_briefing(_parts([], found))
+    assert text.index("q_1: instead of “read |x| as the sup norm; or the l2 norm”, use the l2 norm") < text.index("q_2 (verifier): Gamma is SL2(Z[1/p])")
+    assert "q_3" not in text  # a choice the researcher kept says nothing new
+    assert "do not ask them again" in text
+
+
+def test_the_run_briefs_each_turn_with_the_node_s_standing_questions():
+    log = [{"kind": "question", "id": "q_1", "role": "prover", "by": "claude-code", "question": "take N = 3; or leave it general"},
+           {"kind": "answer", "question_id": "q_1", "keep": False, "redirect": "leave N general", "by": "human"}]
+    agent = _ScriptedAgent(log, [])
+    run = AgentRun(agent, _hooks(work_log=lambda: list(log)))
+    run.start("claude")
+    _until(lambda: not run.active(), "still active")
+    assert "q_1: instead of “take N = 3; or leave it general”, leave N general" in agent.started[0]["prompt"]
