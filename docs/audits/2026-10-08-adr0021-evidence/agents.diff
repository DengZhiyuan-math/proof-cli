+    assert ReaderContext(tmp_path, name="reader-1").env()["PROOF_AGENT_NAME"] == "reader-1"
+    assert ProofAgentContext("N", tmp_path, name="claude-code", role="prover").env()["PROOF_AGENT_NAME"] == "claude-code"
+    assert MapAgentContext(tmp_path, name="map-1").env()["PROOF_AGENT_NAME"] == "map-1"
+    brief = ReaderContext(tmp_path, name="reader-1").brief()
+    import re
+
+    assert re.search(r"`proof reference import <ref-id>[^`]*--created-by reader-1`", brief), brief
+
+
+def test_the_reader_creates_no_claim_and_no_child_whatever_its_statement_says(tmp_path: Path):
+    """P2-2: `*` matches spaces, so `create * theorem *` let a Claim through whose statement names a theorem; the kind is
+    matched where it stands, before the quoted statement, and a create under a parent is refused."""
+    allowed, denied = _allowed_denied(ReaderContext(tmp_path, name="reader-1").claude_args(True))
+    for command in ('proof node create c1 claim "By the theorem of Ratner, every orbit closure is homogeneous" --created-by reader-1',
+                    'proof node create c1 claim "A lemma" --created-by reader-1',
+                    "proof node create c1 claim 'By the theorem \"x\"' --created-by reader-1",
+                    'proof node create c1 claim --created-by reader-1 "By the theorem "',
+                    'proof node create c1 "claim" "By the theorem of Ratner"',
+                    'proof node create c1 lemma "Height bound" --parent thm_main --created-by reader-1',
+                    'proof node create c1 lemma "Height bound" --created-by reader-1 --parent=thm_main'):
+        assert not _permitted(command, allowed, denied), command
+    for command in ('proof node create thm_main theorem "Horocycle orbits equidistribute" --created-by reader-1',
+                    'proof node create lem_h lemma "By the theorem of Ratner, the height is proper" --dependency imp_r --created-by reader-1',
+                    'proof node create imp_r imported_result "Every ergodic measure is homogeneous" --source-locator "Thm 1" --source-version "1991" --reference-id ref_r --created-by reader-1'):
+        assert _permitted(command, allowed, denied), command
+
+
+def test_a_second_reader_turn_may_correct_its_own_unfixed_text(tmp_path: Path):
+    """P2-2: ADR-0021 point 6 — an agent may restate the unfixed text an agent wrote (proof-cli checks whose it is)."""
+    ctx = ReaderContext(tmp_path, name="reader-1")
+    allowed, denied = _allowed_denied(ctx.claude_args(True))
+    for command in ('proof node restate thm_main --statement "Horocycle orbits equidistribute effectively" --reason "the draft means the rate" --by reader-1',
+                    'proof definition edit def_height --text "$h(x) = \\sup 1/\\operatorname{Im}$ over a fundamental domain" --reason "finite" --by reader-1'):
+        assert _permitted(command, allowed, denied), command
+    brief = " ".join(ctx.brief().split())
+    assert "proof node restate <id>" in brief and "proof definition edit <def-id>" in brief and "--by reader-1" in brief
+
+
+def test_the_reader_leaves_out_the_typed_metadata_a_trust_rule_reads(tmp_path: Path):
+    """P2-7: a Trust rule (`identifier has DOI`, `source_type in {…}`) would make the Reader's paraphrase of a result callable
+    with no Reference review of it; the Reader gives the link as --url and leaves the typed metadata to the researcher."""
+    ctx = ReaderContext(tmp_path, name="reader-1")
