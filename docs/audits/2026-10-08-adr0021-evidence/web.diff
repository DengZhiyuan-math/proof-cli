+// -- ADR-0021: Provisional, Conditional and Parked on the map ------------------------------------------
+function nodeMarks(n) {
+  const marks = [];
+  if (n.parked) marks.push({ cls: "parked", text: "parked", title: `Parked: ${n.parked}. The agents went on with the rest; it waits in the review queue.` });
+  if (n.provisional) marks.push({ cls: "provisional", text: "provisional", title: "Provisional: rested on for work by its statement, never its proof. Not trust until you decide it." });
+  const on = n.conditional_on || [];
+  if (on.length) marks.push({ cls: "conditional", text: "conditional", title: `Conditional on ${on.join(", ")}: it stands only if they do.` });
+  return marks;
+}
+
+// -- the review queue (ADR-0021 point 10): everything waiting on the researcher, bottom-up -------------
+const QUEUE_KIND = { parked: "Parked", provisional: "Provisional", imported: "Citation", question: "Question", unfixed: "Unfixed text" };
+let queueData = { items: [], departures: null };
+
+function queueLink(id) {
+  const n = mapData && mapData.nodes.find((m) => m.id === id);
+  return el("a", id, { href: n ? pageOf(n) : `#/node/${encodeURIComponent(id)}` });
+}
+
+function queueItem(item) {
+  const li = el("li");
+  li.dataset.kind = item.kind;
+  const body = el("div", null, { class: "queue-body" });
+  const meta = el("div", null, { class: "queue-meta" });
+  if (item.node_id) { body.append(queueLink(item.node_id), el("span", ` · ${item.statement}`)); }
+  if (item.kind === "parked") {
+    meta.textContent = `the agents could not go on: ${item.reason}`;
+    const tried = el("ul", null, { class: "queue-attempts" });
+    for (const a of item.attempts || []) tried.append(el("li", `${a.goal} — ${a.method ? `${a.method}: ` : ""}failed on ${a.failed_on}`));
+    li.append(el("span", QUEUE_KIND[item.kind], { class: `queue-kind ${item.kind}` }), body, meta);
+    if (tried.children.length) li.append(tried);
+    return li;
+  }
+  if (item.kind === "provisional") meta.textContent = `the Verifier passed snapshot v${item.snapshot}; Accept it to make what rests on it decidable` + ((item.conditional_on || []).length ? ` · itself conditional on ${item.conditional_on.join(", ")}` : "");
+  if (item.kind === "imported") meta.textContent = "an imported result no one has Reference-reviewed: the runs rely on its statement";
+  if (item.kind === "unfixed") {
+    if (item.definition_id) {
+      body.append(el("b", `${item.definition_id} · ${item.term}`), el("span", ` ${item.text}`));
+      meta.textContent = `a Definition ${item.by} wrote; named by ${(item.named_by || []).join(", ") || "no node yet"}; editable until a decision relies on it`;
+    } else meta.textContent = `stated by ${item.by}; editable until a Review decision relies on it`;
+  }
+  li.append(el("span", QUEUE_KIND[item.kind], { class: `queue-kind ${item.kind}` }), body, meta);
+  if (item.kind === "question") {
+    body.append(el("p", item.question, { class: "queue-question" }));
+    meta.textContent = `the choice ${item.by || "a role"} made instead of stopping`;
+    const form = el("div", null, { class: "queue-answer" });
+    const other = el("input", null, { placeholder: "the other reading, if it should change" });
+    const keep = el("button", "Keep the choice", { type: "button" });
+    const answer = el("button", "Redirect", { type: "button", class: "primary" });
+    const send = async (payload) => {
+      try { await api(`/api/node/${encodeURIComponent(item.node_id)}/answer`, { question: item.question_id, ...payload }); }
+      catch (error) { showError(error); return; }
+      say(payload.keep ? `The choice on ${item.node_id} stands.` : `${item.node_id}'s next run is redirected.`, "ok");
+      await loadQueue();
+    };
+    keep.addEventListener("click", () => send({ keep: true }));
+    answer.addEventListener("click", () => { if (other.value.trim()) return send({ answer: other.value.trim() }); say("Say the reading to follow.", "error"); });
+    form.append(other, keep, answer);
+    li.append(form);
+  }
+  return li;
+}
+
