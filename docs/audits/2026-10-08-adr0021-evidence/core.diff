+            f"{what} is fixed: the {fixed['kind'].replace('_', ' ')} decision {fixed['review_id']} on {fixed['node_id']} relied on it; "
+            "state a corrected version as a new node or definition",
+            details={"fixed_by": fixed},
+        )
