+def _clauses(sentence: str) -> Iterator[str]:
+    """Split separate source checks, preserving commas in import lists and explanations."""
+    for segment in sentence.split(";"):
+        parts = iter(_CHECK_COMMA.split(segment))
+        clause = next(parts)
+        for part in parts:
+            if re.search(r"\b(?:un)?checked\b", clause, re.IGNORECASE):
+                yield clause
+                clause = part
+            else:
+                # "R, R2: unchecked ..." names both imports in one check.
+                clause += ", " + part
+        yield clause
+
