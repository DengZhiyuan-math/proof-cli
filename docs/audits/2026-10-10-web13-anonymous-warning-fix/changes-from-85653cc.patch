+@pytest.mark.parametrize("note", [
+    "Unchecked against the source; R2's paper could not be opened.",
+    "R2's statement differs from the cited version; unchecked against the source.",
+])
+def test_an_unnamed_unchecked_clause_uses_the_import_named_in_its_sentence(store, note):
+    _two_imports(store)
+    create_node(store, node_id="L", kind="lemma", statement="L", dependencies=["R", "R2"], created_by="reader-1")
+    _checked(store, "L", note)
+    assert _marked(store, "R") == []
+    assert _marked(store, "R2") == [("L", 1, True)]
+    client = DirectClient(store)
+    try:
+        pending = client.get("/api/state")[1]["data"]["pending"]
+        queue = client.get("/api/review-queue")[1]["data"]["items"]
+        for node_id, expected in (("R", []), ("R2", [("L", 1, True, note)])):
+            reviews = [client.get(f"/api/node/{node_id}")[1]["data"]["import_review"],
+                       next(item for item in pending if item["node_id"] == node_id),
+                       next(item for item in queue if item["kind"] == "imported" and item["node_id"] == node_id)]
+            for review in reviews:
+                assert [(m["dependent"], m["snapshot"], m["current"], m["note"]) for m in review["unchecked"]] == expected
+    finally:
+        client.app.close()
+
+
+def test_the_sentence_fallback_does_not_take_an_import_from_another_sentence(store):
+    _two_imports(store)
+    create_node(store, node_id="L", kind="lemma", statement="L", dependencies=["R", "R2"], created_by="reader-1")
+    _checked(store, "L", "R: checked against the source. Unchecked against the source; R2's paper could not be opened.")
+    assert _marked(store, "R") == []
+    assert _marked(store, "R2") == [("L", 1, True)]
+
+
